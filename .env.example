# Supabase Postgres — pooled connection (Prisma Client runtime, PgBouncer port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Postgres — direct connection (used only by `prisma migrate`, port 5432, no PgBouncer)
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase project + Storage (service role key is SERVER-ONLY — never prefix with NEXT_PUBLIC_)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-secret-key>"

# Admin auth
ADMIN_PASSWORD="change-me"
SESSION_SECRET="<64-char-random-hex, e.g. `openssl rand -hex 32`>"

# Public contact numbers used in click-to-call / click-to-WhatsApp links
NEXT_PUBLIC_WHATSAPP_NUMBER="91XXXXXXXXXX"
NEXT_PUBLIC_CALL_NUMBER="+91XXXXXXXXXX"

# Lead notification email — sent to ADMIN_NOTIFY_EMAIL whenever a student submits a lead.
# For Gmail: host smtp.gmail.com, port 465, user is your Gmail address, pass is a 16-char
# App Password (Google Account -> Security -> 2-Step Verification -> App passwords), NOT your
# normal Gmail password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS="<app-password>"
ADMIN_NOTIFY_EMAIL="you@gmail.com"
